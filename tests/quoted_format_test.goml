package tests;

use ecosystem::mime;
use std::testing;

#[test]
fn large_quoted_parameter_preserves_escaping_and_exact_budgets() -> () {
    let raw: Vec[byte] = Vec::new();
    let escaped: Vec[byte] = Vec::new();
    for _ in 0..2048 {
        for byte in b"a\"\\\t ".as_slice() {
            raw.push(byte);
        }
        for byte in b"a\\\"\\\\\t ".as_slice() {
            escaped.push(byte);
        }
    }
    let value = string_from_utf8(raw).1;
    let expected = "text/plain; note=\"" + string_from_utf8(escaped).1 + "\"";
    let media = mime::MediaType {
        essence: "text/plain",
        parameters: Vec::from_array([mime::Parameter { name: "note", value }]),
    };
    let limits = mime::Limits {
        max_value_bytes: value.byte_len(),
        max_output_bytes: expected.byte_len(),
        ..mime::Limits::standard(),
    };
    let output = testing::expect_ok(mime::format_media_type(media, limits), "large quoted value");
    testing::assert_eq(output, expected);
    let parsed = testing::expect_ok(mime::parse_media_type(output, limits), "reparse");
    testing::assert_eq(testing::expect_some(parsed.parameter("note"), "note"), value);
    for limited in[
        mime::Limits { max_value_bytes: value.byte_len() - 1, ..limits },
        mime::Limits { max_output_bytes: expected.byte_len() - 1, ..limits },
    ] {
        testing::assert_eq(
            testing::expect_err(mime::format_media_type(media, limited), "exact budgets").kind,
            mime::ErrorKind::Limit,
        );
    }
}
